---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Portfolio">
  <section class="hero">
    <h1>Phantom Operator</h1>
    <p>High Speed Cinematografie</p>
  </section>

  <section class="portfolio-grid">
    {Array.from({length: 12}).map((_, i) => (
      <div class="portfolio-item">
        <div class="placeholder">
          <span>Project {i + 1}</span>
        </div>
      </div>
    ))}
  </section>
</Layout>

<style>
  .hero {
    padding: 6rem 2rem 4rem;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 100;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #fff;
  }

  .hero p {
    margin-top: 1rem;
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2px;
    padding: 0 2px 2px;
  }

  .portfolio-item {
    aspect-ratio: 16/9;
    overflow: hidden;
    cursor: pointer;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    background: var(--mid);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s;
  }

  .portfolio-item:hover .placeholder { background: #252525; }

  .placeholder span {
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
