---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact">
  <div class="page">
    <div class="contact-left">
      <h1>CONTACT</h1>
      <ul class="info">
        <li><a href="mailto:frank@artofslowmotion.com">frank@artofslowmotion.com</a></li>
        <li><a href="tel:+31612415418">Tel: +31 (0) 6 12415418</a></li>
      </ul>
    </div>

    <div class="contact-right">
      <form class="contact-form" name="contact" method="POST" data-netlify="true">
        <div class="form-row">
          <div class="field">
            <label for="voornaam">Voornaam</label>
            <input type="text" id="voornaam" name="voornaam" />
          </div>
          <div class="field">
            <label for="achternaam">Achternaam</label>
            <input type="text" id="achternaam" name="achternaam" />
          </div>
        </div>
        <div class="field">
          <label for="email">Email *</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="field">
          <label for="onderwerp">Onderwerp</label>
          <input type="text" id="onderwerp" name="onderwerp" />
        </div>
        <div class="field">
          <label for="datum">Optie datum voor high speed shoot</label>
          <input type="date" id="datum" name="datum" />
        </div>
        <fieldset class="checkboxes">
          <legend>Phantom camera set:</legend>
          <label class="check">
            <input type="checkbox" name="set" value="flex25k" checked /> Phantom Flex 2.5k set
          </label>
          <label class="check">
            <input type="checkbox" name="set" value="flex4k" /> Phantom Flex 4k set
          </label>
          <label class="check">
            <input type="checkbox" name="set" value="onderwaterhuis" /> Onderwaterhuis
          </label>
        </fieldset>
        <div class="field">
          <label for="bericht">Laat een bericht achter ...</label>
          <textarea id="bericht" name="bericht" rows="5"></textarea>
        </div>
        <button type="submit" class="btn">Verstuur</button>
      </form>
    </div>
  </div>
</Layout>

<style>
  .page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-left h1 {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    margin-bottom: 2rem;
    color: var(--text);
  }

  .info {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .info a {
    font-size: 0.95rem;
    color: var(--muted);
    transition: color 0.2s;
  }

  .info a:hover { color: var(--text); }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .field { display: flex; flex-direction: column; gap: 0.35rem; }

  label { font-size: 0.85rem; color: var(--muted); }

  input, textarea {
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 0.6rem 0.75rem;
    font-size: 0.95rem;
    font-family: inherit;
    color: var(--text);
    background: var(--white);
    transition: border-color 0.2s;
    resize: vertical;
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: var(--active);
  }

  input[type="date"] { cursor: pointer; }

  .checkboxes {
    border: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .checkboxes legend {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text);
    cursor: pointer;
  }

  .check input[type="checkbox"] {
    width: 16px;
    height: 16px;
    padding: 0;
    cursor: pointer;
    accent-color: var(--active);
    border: 1px solid var(--border);
  }

  .btn {
    align-self: flex-end;
    background: var(--text);
    color: var(--white);
    border: none;
    padding: 0.7rem 2.5rem;
    font-size: 0.85rem;
    font-family: inherit;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 2px;
    transition: background 0.2s;
  }

  .btn:hover { background: #000; }

  @media (max-width: 768px) {
    .page {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2rem 1rem 3rem;
    }
    .form-row { grid-template-columns: 1fr; }
    .btn { align-self: flex-start; }
  }
</style>
