---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Camera Gear">
  <div class="hero">
    <img
      src="https://static.wixstatic.com/media/015c01_c22975b109e245d0ad6720f1478ba29f~mv2.jpg/v1/fill/w_1200,h_400,q_85,enc_avif,quality_auto/015c01_c22975b109e245d0ad6720f1478ba29f~mv2.jpg"
      alt="Camera Gear"
      class="hero-img"
    />
    <div class="hero-overlay">
      <h1>Camera Gear</h1>
    </div>
  </div>

  <div class="content">
    <h2 class="section-title">Camera Gear</h2>

    <div class="gear-list">

      <div class="gear-item">
        <div class="gear-left gear-left--text">
          <h3>Phantom Flex 2.5 K</h3>
        </div>
        <div class="gear-right">
          <ul>
            <li>35mm sensor tot 2.5K resolutie. Op volledige resolutie tot 1.500 FPS</li>
            <li>Op 1920 × 1080 resolutie maar liefst 2.500 FPS</li>
            <li>Resolutie kan via AI ge-upscaled worden. Neem contact op voor meer informatie.</li>
            <li>800 Iso rating op 25fps.</li>
            <li>4:2:2 DH-SDI out</li>
            <li>12-bit pixel depth</li>
          </ul>
          <p class="gear-link"><a href="https://www.phantomhighspeed.com" target="_blank" rel="noopener">Voor meer info download hier het data-sheet doc.</a></p>
        </div>
      </div>

      <div class="gear-item">
        <div class="gear-left gear-left--text">
          <h3>DZO Film zoom PL Lens set</h3>
        </div>
        <div class="gear-right">
          <ul>
            <li>DZOFilm Zoom Bundle 20-50mm + 50-125mm T2.9</li>
            <li>Super35 Parfocal Zoom Lens</li>
            <li>Swappable PL Mount; Canon EF Included</li>
          </ul>
        </div>
      </div>

      <div class="gear-item">
        <div class="gear-left gear-left--text">
          <h3>High Speed LED lampen</h3>
        </div>
        <div class="gear-right">
          <p>Speciaal voor high speed ontwikkelde LED lampen.</p>
          <p>Gebruiken relatief weinig stroom en ruim voldoende voor kleinere sets.</p>
        </div>
      </div>

      <div class="gear-item">
        <div class="gear-left gear-left--text">
          <h3>Onderwaterhuis</h3>
        </div>
        <div class="gear-right">
          <p>Onderwaterbehuizing voor de Flex 2.5k. Camera wordt bestuurd via laptop op de kant en focus, iris en zoom met remote follow focus. Afstand onderwaterhuis en laptop is standaard beperkt, echter per project aan te passen. Neem contact op voor meer info!</p>
        </div>
      </div>

      <div class="gear-item">
        <div class="gear-left gear-left--text">
          <h3>Basis set Phantom Flex</h3>
        </div>
        <div class="gear-right">
          <p class="gear-sub">De basis set Phantom bestaat uit:</p>
          <ul>
            <li>Phantom Flex 2.5 K</li>
            <li>DZO Zoom PL Lens set</li>
            <li>Sachtler Flowtech tripod met Aktiv8 Touch &amp; Go Fluidhead</li>
            <li>24" Flanders DM240 Afkijk Monitor</li>
            <li>Shogun monitor met recording voor 4:2:2 opnames</li>
            <li>Laptop voor aansturing camera en RAW recordings</li>
            <li>Phantom operator</li>
          </ul>
          <a href="/contact" class="cta-link">Deze set boeken? Klik hier voor een prijsopgave!</a>
        </div>
      </div>

    </div>

    <div class="divider"></div>

    <h2 class="form-heading">Let's Work Together</h2>
    <p class="form-sub">Get in touch so we can start working together.</p>

    <form class="contact-form" name="cameragear" method="POST" data-netlify="true">
      <div class="form-row">
        <div class="field">
          <label for="first">First Name</label>
          <input type="text" id="first" name="first_name" />
        </div>
        <div class="field">
          <label for="last">Last Name</label>
          <input type="text" id="last" name="last_name" />
        </div>
      </div>
      <div class="field">
        <label for="email">Email *</label>
        <input type="email" id="email" name="email" required />
      </div>
      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="4"></textarea>
      </div>
      <button type="submit" class="btn">Send</button>
    </form>
  </div>
</Layout>

<style>
  .hero {
    position: relative;
    height: 320px;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-overlay h1 {
    background: rgba(255,255,255,0.9);
    padding: 0.75rem 2.5rem;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 400;
    color: var(--text);
  }

  .content {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.5rem 2rem 4rem;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: 2rem;
  }

  .gear-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .gear-item {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .gear-left img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 2px;
  }

  .gear-left--text {
    display: flex;
    align-items: flex-start;
    padding-top: 0.25rem;
  }

  .gear-left--text h3,
  .gear-title-row h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
  }

  .gear-title-row {
    margin-bottom: 0.75rem;
  }

  .gear-right ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .gear-right li {
    font-size: 0.9rem;
    color: var(--muted);
    padding-left: 1rem;
    position: relative;
  }

  .gear-right li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: #bbb;
  }

  .gear-right p { font-size: 0.9rem; color: var(--muted); margin-bottom: 0.5rem; }
  .gear-sub { margin-bottom: 0.75rem; }
  .gear-link a { font-size: 0.85rem; color: var(--active); }
  .gear-link a:hover { text-decoration: underline; }

  .cta-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--active);
    text-decoration: underline;
  }

  .divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 3rem 0;
  }

  .form-heading {
    font-size: 1.4rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
  }

  .form-sub { color: var(--muted); margin-bottom: 2rem; }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 560px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .field { display: flex; flex-direction: column; gap: 0.35rem; }

  label { font-size: 0.85rem; color: var(--muted); }

  input, textarea {
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 0.6rem 0.75rem;
    font-size: 0.95rem;
    font-family: inherit;
    color: var(--text);
    background: var(--white);
    transition: border-color 0.2s;
    resize: vertical;
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: var(--active);
  }

  .btn {
    align-self: flex-start;
    background: var(--text);
    color: var(--white);
    border: none;
    padding: 0.7rem 2rem;
    font-size: 0.85rem;
    font-family: inherit;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 2px;
    transition: background 0.2s;
  }

  .btn:hover { background: #000; }

  @media (max-width: 768px) {
    .hero { height: 200px; }
    .gear-item { grid-template-columns: 1fr; gap: 1rem; }
    .gear-left img { height: 200px; }
    .form-row { grid-template-columns: 1fr; }
    .content { padding: 2rem 1rem 3rem; }
  }
</style>
