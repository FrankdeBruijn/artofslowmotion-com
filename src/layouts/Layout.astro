---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Art of Slowmotion – Phantom Operator & High Speed Cinematografie" } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
  <title>{title} | Art of slowmotion</title>
</head>
<body>
  <header>
    <div class="header-inner">
      <a href="/" class="logo-link">
        <img src="/logo.jpg" alt="Art of Slowmotion" class="logo" />
      </a>
      <button class="menu-toggle" id="menuToggle" aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <nav id="mainNav">
        <ul>
          <li><a href="/" class={currentPath === "/" ? "active" : ""}>Portfolio</a></li>
          <li><a href="/diensten" class={currentPath === "/diensten" ? "active" : ""}>Diensten</a></li>
          <li><a href="/camera-gear" class={currentPath === "/camera-gear" ? "active" : ""}>Camera Gear</a></li>
          <li><a href="/contact" class={currentPath === "/contact" ? "active" : ""}>Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <div class="footer-inner">
      <ul class="social">
        <li><a href="https://vimeo.com/frankdebruijn" target="_blank" rel="noopener">Vimeo</a></li>
        <li><a href="https://www.instagram.com/frankdebruijnfilmmaker/" target="_blank" rel="noopener">Instagram</a></li>
        <li><a href="https://www.facebook.com/artofslowmotion" target="_blank" rel="noopener">Facebook</a></li>
        <li><a href="https://www.linkedin.com/company/art-of-slowmotion" target="_blank" rel="noopener">LinkedIn</a></li>
      </ul>
      <p class="footer-contact">
        Frank de Bruijn &nbsp;|&nbsp; Handel &nbsp;|&nbsp; Tel. 06 12415418 &nbsp;|&nbsp;
        <a href="mailto:frank@artofslowmotion.com">frank@artofslowmotion.com</a>
      </p>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('menuToggle');
    const nav = document.getElementById('mainNav');
    toggle?.addEventListener('click', () => {
      const open = nav?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    nav?.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        nav.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
      });
    });
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --white: #ffffff;
    --bg: #f9f8f8;
    --border: #e0e0e0;
    --text: #333333;
    --muted: #666666;
    --active: #00a4b8;
    --max: 1200px;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--white);
    color: var(--text);
    font-family: 'Open Sans', sans-serif;
    font-size: 16px;
    line-height: 1.6;
  }

  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }

  /* ── HEADER ── */
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--white);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
  }

  .logo-link { display: flex; align-items: center; }
  .logo { height: 55px; width: auto; }

  nav ul {
    list-style: none;
    display: flex;
    gap: 3rem;
  }

  nav ul a {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text);
    transition: color 0.2s;
  }

  nav ul a:hover { color: var(--active); }
  nav ul a.active { color: var(--active); }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--text);
    transition: all 0.3s;
  }

  /* ── MAIN ── */
  main { min-height: 70vh; }

  /* ── FOOTER ── */
  footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 2rem;
    background: var(--white);
  }

  .footer-inner {
    max-width: var(--max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .social {
    list-style: none;
    display: flex;
    gap: 1.5rem;
  }

  .social a {
    font-size: 0.85rem;
    color: var(--muted);
    transition: color 0.2s;
  }

  .social a:hover { color: var(--text); }

  .footer-contact {
    font-size: 0.8rem;
    color: var(--muted);
    text-align: center;
  }

  .footer-contact a { color: var(--muted); }
  .footer-contact a:hover { color: var(--text); }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .header-inner { padding: 0 1rem; }
    .logo { height: 42px; }
    .menu-toggle { display: flex; }

    nav {
      display: none;
      position: absolute;
      top: 80px;
      left: 0; right: 0;
      background: var(--white);
      border-bottom: 1px solid var(--border);
      padding: 1rem 0;
    }

    nav.open { display: block; }

    nav ul {
      flex-direction: column;
      gap: 0;
    }

    nav ul a {
      display: block;
      padding: 0.75rem 1.5rem;
      font-size: 0.95rem;
    }

    .footer-inner { gap: 1rem; }
  }
</style>
