---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Art of Slowmotion – Phantom Operator & High Speed Cinematografie" } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" />
  <title>{title} — Art of Slowmotion</title>
</head>
<body>
  <header>
    <nav>
      <a href="/" class="logo">Art of Slowmotion</a>
      <button class="menu-toggle" aria-label="Menu">&#9776;</button>
      <ul>
        <li><a href="/" class={currentPath === "/" ? "active" : ""}>Portfolio</a></li>
        <li><a href="/diensten" class={currentPath === "/diensten" ? "active" : ""}>Diensten</a></li>
        <li><a href="/camera-gear" class={currentPath === "/camera-gear" ? "active" : ""}>Camera Gear</a></li>
        <li><a href="/contact" class={currentPath === "/contact" ? "active" : ""}>Contact</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <div class="footer-inner">
      <p>&copy; {new Date().getFullYear()} Art of Slowmotion — Frank de Bruijn</p>
      <div class="social">
        <a href="https://vimeo.com/artofslowmotion" target="_blank">Vimeo</a>
        <a href="https://www.instagram.com/frankdebruijnfilmmaker" target="_blank">Instagram</a>
        <a href="https://www.facebook.com/artofslowmotion" target="_blank">Facebook</a>
        <a href="https://www.linkedin.com/company/artofslowmotion" target="_blank">LinkedIn</a>
      </div>
    </div>
  </footer>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --black: #080808;
    --dark: #111;
    --mid: #1a1a1a;
    --accent: #fff;
    --gold: #c8a96e;
    --text: #ccc;
    --muted: #666;
    --max: 1200px;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--black);
    color: var(--text);
    font-family: 'Helvetica Neue', Arial, sans-serif;
    line-height: 1.6;
  }

  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }

  header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: rgba(8,8,8,0.9);
    backdrop-filter: blur(10px);
  }

  nav {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  .logo {
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  nav ul { list-style: none; display: flex; gap: 2.5rem; }

  nav ul a {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s;
  }

  nav ul a:hover, nav ul a.active { color: var(--accent); }

  .menu-toggle { display: none; background: none; border: none; color: var(--accent); font-size: 1.5rem; cursor: pointer; }

  main { padding-top: 70px; min-height: 80vh; }

  footer {
    border-top: 1px solid #1a1a1a;
    padding: 2.5rem 2rem;
  }

  .footer-inner {
    max-width: var(--max);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }

  .social { display: flex; gap: 2rem; }
  .social a { text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.1em; }
  .social a:hover { color: var(--accent); }

  .page-header {
    padding: 5rem 2rem 3rem;
    max-width: var(--max);
    margin: 0 auto;
  }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .section {
    padding: 3rem 2rem;
    max-width: var(--max);
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .menu-toggle { display: block; }
    nav ul { display: none; }
    .footer-inner { flex-direction: column; gap: 1.5rem; text-align: center; }
  }
</style>
